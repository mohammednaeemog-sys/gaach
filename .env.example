# PostgreSQL database. Free: create a Neon database from Vercel (Storage tab) or at neon.tech,
# then paste its connection string here. See DEPLOY.md.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Online only: your private admin login (set up on every build; the demo admin is then locked)
# ADMIN_EMAIL="you@gmail.com"
# ADMIN_PASSWORD="a-long-password-1"

# Online only: admin photo storage. Vercel adds this when you connect a Blob store.
# BLOB_READ_WRITE_TOKEN=""

# Tree Advisor AI (optional). Without a key the advisor answers from Gaach's own data.
# Free: get a key at https://aistudio.google.com/apikey (Google account, no card)
GEMINI_API_KEY=""
# GEMINI_MODEL=""   # optional; by default tries gemini-3.5-flash, gemini-3.8-flash, then gemini-3.5-flash-lite

# Paid: Claude from https://console.anthropic.com (used instead of Gemini when set)
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5-5"
# AI_PROVIDER="gemini"   # pick one when both keys are set

# Forgot-password emails (free with Gmail). Turn on 2-Step Verification in your
# Google account, create an App password at https://myaccount.google.com/apppasswords
# and paste it here (no spaces). Without these, reset links print in the terminal.
SMTP_USER=""          # e.g. gaach.company@gmail.com
SMTP_PASS=""          # the 16-letter App password, never the account password
# MAIL_FROM="Gaach <gaach.company@gmail.com>"
# Optional: another SMTP server (Brevo: smtp-relay.brevo.com, port 587)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# The site's public address, used in email links once it is online
# APP_URL="https://your-site.example"
